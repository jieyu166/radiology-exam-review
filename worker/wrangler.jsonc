{
  // Cloudflare Worker for radiology-exam-review accounts + progress sync.
  // Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rex-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-10",
  "observability": { "enabled": true },

  // D1: create once with `npx wrangler d1 create rex-progress` and paste the returned database_id below.
  // The placeholder id is enough for `wrangler dev` (local SQLite) but `wrangler deploy` requires the real id.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rex-progress",
      "database_id": "66b6e529-765a-4d49-a0d5-4a6250fdc414",
      "migrations_dir": "migrations"
    }
  ],

  // Login throttling: 5 attempts per 60 s per normalized username (first layer; D1 lockout is the second).
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],

  "vars": {
    // Comma-separated browser origins allowed to call this API (no trailing slash).
    "ALLOWED_ORIGINS": "https://jieyu166.github.io,http://localhost:8777,http://127.0.0.1:8777",
    // Comma-separated usernames that get role=admin on login.
    "ADMIN_USERNAMES": "jieyu166"
  }
  // Secrets (set with `npx wrangler secret put <NAME>`):
  //   BOOTSTRAP_INVITE_CODE — accepted as an invite only while the users table is empty.
}
