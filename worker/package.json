{
  "name": "rex-api",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker + D1 backend for radiology-exam-review: invite-only accounts and append-only study progress sync",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test \"test/*.test.js\"",
    "migrate:local": "wrangler d1 migrations apply rex-progress --local",
    "migrate:remote": "wrangler d1 migrations apply rex-progress --remote",
    "smoke": "bash test/smoke.sh"
  },
  "devDependencies": {
    "wrangler": "^4.149.0"
  }
}
